// Schema do banco.
//
// As entidades entram módulo a módulo, na ordem da tabela do CLAUDE.md.
//
// Convenções:
//   - nomes de model em PascalCase singular (User, Lesson, ReviewCard);
//   - nome físico da tabela em snake_case plural via @@map ("review_cards");
//   - colunas em snake_case via @map;
//   - toda tabela tem id (uuid), created_at e updated_at.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Módulo 2 — ai
// ---------------------------------------------------------------------------

enum AiCallStatus {
  OK               @map("ok")
  CACHE_HIT        @map("cache_hit")
  VALIDATION_ERROR @map("validation_error")
  PROVIDER_ERROR   @map("provider_error")

  @@map("ai_call_status")
}

enum AiTier {
  FAST  @map("fast")
  SMART @map("smart")

  @@map("ai_tier")
}

/// Uma linha por chamada de IA. Append-only: é a base do controle de custo
/// e do consumo de AiCredit do plano Plus (módulo 11).
model AiUsage {
  id String @id @default(uuid()) @db.Uuid

  /// Ausente quando a chamada é do sistema, não de um aluno.
  userId        String? @map("user_id") @db.Uuid
  feature       String
  promptId      String  @map("prompt_id")
  promptVersion Int     @map("prompt_version")
  model         String
  tier          AiTier

  inputTokens   Int @map("input_tokens")
  outputTokens  Int @map("output_tokens")
  /// Custo em milionésimos de dólar. Inteiro: dinheiro não usa float.
  costUsdMicros Int @map("cost_usd_micros")
  latencyMs     Int @map("latency_ms")

  status         AiCallStatus
  cacheHit       Boolean      @default(false) @map("cache_hit")
  /// Preenchido quando status != OK. Nunca guarda o conteúdo do aluno.
  errorCode      String?      @map("error_code")
  /// Quantas tentativas de reparo do JSON foram necessárias (0, 1).
  repairAttempts Int          @default(0) @map("repair_attempts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
  @@map("ai_usages")
}

/// Cache durável de resultados caros de IA, compartilhado entre alunos.
/// O Redis é a camada quente; esta tabela sobrevive a um flush dele.
model AiCacheEntry {
  id String @id @default(uuid()) @db.Uuid

  /// hash(promptId, promptVersion, model, entrada normalizada).
  cacheKey      String @unique @map("cache_key")
  promptId      String @map("prompt_id")
  promptVersion Int    @map("prompt_version")
  model         String

  /// A saída já validada pelo zod do prompt.
  payload Json
  hits    Int  @default(0)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([promptId, promptVersion])
  @@index([expiresAt])
  @@map("ai_cache_entries")
}

// ---------------------------------------------------------------------------
// Módulo 3 — auth / users / onboarding
// ---------------------------------------------------------------------------

enum Role {
  STUDENT @map("student")
  EDITOR  @map("editor")
  ADMIN   @map("admin")

  @@map("role")
}

enum OAuthProvider {
  GOOGLE @map("google")

  @@map("oauth_provider")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")

  @@map("auth_token_purpose")
}

enum LearningGoal {
  TRAVEL        @map("travel")
  WORK          @map("work")
  EXAMS         @map("exams")
  SCHOOL        @map("school")
  MOVING_ABROAD @map("moving_abroad")
  CONVERSATION  @map("conversation")
  OTHER         @map("other")

  @@map("learning_goal")
}

enum SelfReportedLevel {
  NONE         @map("none")
  BASIC        @map("basic")
  INTERMEDIATE @map("intermediate")
  ADVANCED     @map("advanced")

  @@map("self_reported_level")
}

enum PreferredStudyTime {
  MORNING   @map("morning")
  AFTERNOON @map("afternoon")
  EVENING   @map("evening")
  NIGHT     @map("night")
  ANY       @map("any")

  @@map("preferred_study_time")
}

/// De onde veio o interesse: o aluno escolheu, ou o sistema aprendeu.
enum InterestSource {
  ONBOARDING @map("onboarding")
  LEARNED    @map("learned")

  @@map("interest_source")
}

enum ConsentType {
  TERMS                @map("terms")
  PRIVACY_POLICY       @map("privacy_policy")
  DATA_PERSONALIZATION @map("data_personalization")
  MARKETING            @map("marketing")

  @@map("consent_type")
}

enum DataExportStatus {
  PENDING @map("pending")
  READY   @map("ready")
  FAILED  @map("failed")

  @@map("data_export_status")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique
  name         String
  /// Nulo quando a conta nasceu pelo Google e nunca definiu senha.
  passwordHash String? @map("password_hash")
  role         Role    @default(STUDENT)

  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Soft delete imediato pedido pelo aluno (LGPD).
  deletedAt       DateTime? @map("deleted_at")
  /// Preenchido pelo job de anonimização, 30 dias após o soft delete.
  anonymizedAt    DateTime? @map("anonymized_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile       StudentProfile?
  interests     StudentInterest[]
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  authTokens    AuthToken[]
  consents      Consent[]
  dataExports   DataExport[]

  contentDrafts   ContentDraft[]
  contentComments ContentComment[]

  lessonAttempts LessonAttempt[]
  answers        Answer[]
  learningStats  LearningStats?

  learnerSkills        LearnerSkillState[]
  learnerErrorPatterns LearnerErrorPattern[]
  learnerSnapshots     LearnerLevelSnapshot[]
  learnerModelCursor   LearnerModelCursor?
  learnerPlacement     LearnerPlacementPrior?

  placementTests  PlacementTest[]
  unitCheckpoints UnitCheckpoint[]

  reviewCards     ReviewCard[]
  srsUpdateCursor SrsUpdateCursor?

  studyPlan    StudyPlan?
  dailyAgendas DailyAgenda[]

  subscriptions   Subscription[]
  aiCreditEntries AiCreditLedgerEntry[]

  @@index([deletedAt])
  @@map("users")
}

/// Refresh token rotativo. Guardamos só o hash: o valor puro vive no cookie.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash")

  /// Toda a cadeia de rotação compartilha a mesma família. Reuso de um token
  /// já rotacionado revoga a família inteira: sinal clássico de roubo.
  family       String  @db.Uuid
  replacedById String? @map("replaced_by_id") @db.Uuid

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  userAgent String? @map("user_agent")
  ip        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id String @id @default(uuid()) @db.Uuid

  userId            String        @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  email             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Token de uso único: verificação de e-mail e recuperação de senha.
model AuthToken {
  id String @id @default(uuid()) @db.Uuid

  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model StudentProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goals    LearningGoal[]
  /// Texto livre quando o objetivo não cabe nas opções.
  goalNote String?        @map("goal_note")

  /// Minutos por dia da semana: mon, tue, wed, thu, fri, sat, sun.
  availabilityMinutes Json               @default("{}") @map("availability_minutes")
  preferredStudyTime  PreferredStudyTime @default(ANY) @map("preferred_study_time")
  /// Data em que o aluno quer chegar no objetivo. Opcional.
  targetDate          DateTime?          @map("target_date")

  selfReportedLevel SelfReportedLevel @default(NONE) @map("self_reported_level")
  timezone          String            @default("America/Sao_Paulo")
  nativeLanguage    String            @default("pt-BR") @map("native_language")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student_profiles")
}

/// Tema de interesse com peso. O aluno escolhe no onboarding; o sistema
/// acrescenta e reajusta pesos conforme observa o uso (módulo 7).
model StudentInterest {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Slug em inglês: history, football, technology, music, agriculture...
  topic  String
  /// 0 a 100. Quanto maior, mais o conteúdo gerado puxa para este tema.
  weight Int            @default(50)
  source InterestSource @default(ONBOARDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, topic])
  @@index([userId])
  @@map("student_interests")
}

/// Consentimento LGPD, com versão do documento aceito.
model Consent {
  id String @id @default(uuid()) @db.Uuid

  userId  String      @map("user_id") @db.Uuid
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    ConsentType
  /// Versão do documento aceito, ex.: 2026-01-15.
  version String

  granted   Boolean
  grantedAt DateTime? @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, type, version])
  @@index([userId])
  @@map("consents")
}

/// Pedido de portabilidade de dados (LGPD art. 18).
model DataExport {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     DataExportStatus @default(PENDING)
  /// Chave no S3, sob o prefixo exports/. Nula enquanto não está pronto.
  storageKey String?          @map("storage_key")
  sizeBytes  Int?             @map("size_bytes")
  errorCode  String?          @map("error_code")
  /// Depois disso o arquivo é apagado do bucket.
  expiresAt  DateTime?        @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("data_exports")
}

// ---------------------------------------------------------------------------
// Módulo 4 — curriculum
// ---------------------------------------------------------------------------

enum CefrLevel {
  A1 @map("a1")
  A2 @map("a2")
  B1 @map("b1")
  B2 @map("b2")
  C1 @map("c1")

  @@map("cefr_level")
}

enum Competency {
  GRAMMAR    @map("grammar")
  VOCABULARY @map("vocabulary")
  LISTENING  @map("listening")
  READING    @map("reading")
  WRITING    @map("writing")
  SPEAKING   @map("speaking")

  @@map("competency")
}

enum SkillType {
  GRAMMAR       @map("grammar")
  VOCAB_SET     @map("vocab_set")
  CHUNK         @map("chunk")
  FUNCTION      @map("function")
  PRONUNCIATION @map("pronunciation")
  REGISTER      @map("register")

  @@map("skill_type")
}

enum RegisterLevel {
  INFORMAL_SPOKEN @map("informal_spoken")
  NEUTRAL         @map("neutral")
  FORMAL          @map("formal")

  @@map("register_level")
}

/// Ciclo de vida de tudo que é autorado: unidade, lição, item, apostila.
/// DRAFT → IN_REVIEW → APPROVED → PUBLISHED, e ARCHIVED no fim da vida.
/// Editar algo em IN_REVIEW ou APPROVED devolve para DRAFT.
enum ContentStatus {
  DRAFT     @map("draft")
  IN_REVIEW @map("in_review")
  APPROVED  @map("approved")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("content_status")
}

enum LessonStepType {
  SCENE             @map("scene")
  EXPLANATION_CARDS @map("explanation_cards")
  PRACTICE          @map("practice")
  FREE_PRODUCTION   @map("free_production")
  ROLEPLAY          @map("roleplay")
  SUMMARY           @map("summary")

  @@map("lesson_step_type")
}

enum ItemType {
  MULTIPLE_CHOICE       @map("multiple_choice")
  LISTEN_CHOOSE         @map("listen_choose")
  ORDER_WORDS           @map("order_words")
  FILL_BLANK            @map("fill_blank")
  TYPE_ANSWER           @map("type_answer")
  MATCH                 @map("match")
  DICTATION             @map("dictation")
  READING_COMPREHENSION @map("reading_comprehension")
  REGISTER_SWAP         @map("register_swap")

  @@map("item_type")
}

enum ItemSource {
  HUMAN             @map("human")
  /// Saiu do content-studio e ainda não passou por revisão humana.
  AI_DRAFT          @map("ai_draft")
  AI_DRAFT_REVIEWED @map("ai_draft_reviewed")

  @@map("item_source")
}

enum MediaKind {
  AUDIO @map("audio")
  IMAGE @map("image")
  PDF   @map("pdf")

  @@map("media_kind")
}

// --- Taxonomia -------------------------------------------------------------

/// Unidade mínima que o sistema mede.
///
/// O id é um slug **imutável**: ele viaja dentro do JSON das etapas de lição,
/// do errorPatternMap dos itens e do modelo do aluno. Para substituir uma
/// skill, marque `deprecatedAt` e aponte `replacedById` — nunca renomeie.
model Skill {
  id String @id

  type        SkillType
  competency  Competency
  cefrLevel   CefrLevel      @map("cefr_level")
  /// pt-BR.
  title       String
  /// pt-BR.
  description String?
  /// A que objetivos do aluno esta skill serve. O learner-model (7) usa para
  /// priorizar o que estudar. Vazio = serve a todos igualmente.
  goals       LearningGoal[] @default([])

  deprecatedAt DateTime? @map("deprecated_at")
  replacedById String?   @map("replaced_by_id")
  replacedBy   Skill?    @relation("SkillReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     Skill[]   @relation("SkillReplacement")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prerequisites SkillPrerequisite[] @relation("SkillPrerequisiteOwner")
  requiredBy    SkillPrerequisite[] @relation("SkillPrerequisiteTarget")
  commonErrors  SkillErrorPattern[]
  items         ItemSkill[]
  lessons       LessonTargetSkill[]
  registerNote  RegisterNote?

  @@index([cefrLevel, competency])
  @@index([type])
  @@index([deprecatedAt])
  @@map("skills")
}

model SkillPrerequisite {
  id String @id @default(uuid()) @db.Uuid

  skillId        String @map("skill_id")
  skill          Skill  @relation("SkillPrerequisiteOwner", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisiteId String @map("prerequisite_id")
  prerequisite   Skill  @relation("SkillPrerequisiteTarget", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([skillId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("skill_prerequisites")
}

/// Erro típico de brasileiro aprendendo inglês. Slug imutável, como Skill.
model ErrorPattern {
  id String @id

  /// pt-BR: o que o aluno faz de errado.
  description String
  /// A forma errada, em inglês: "I have 20 years."
  example     String
  /// A forma certa: "I'm 20 years old."
  correction  String
  /// pt-BR: por que acontece e como lembrar.
  explanation String

  deprecatedAt DateTime?      @map("deprecated_at")
  replacedById String?        @map("replaced_by_id")
  replacedBy   ErrorPattern?  @relation("ErrorPatternReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     ErrorPattern[] @relation("ErrorPatternReplacement")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills SkillErrorPattern[]

  @@index([deprecatedAt])
  @@map("error_patterns")
}

model SkillErrorPattern {
  id String @id @default(uuid()) @db.Uuid

  skillId        String       @map("skill_id")
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  errorPatternId String       @map("error_pattern_id")
  errorPattern   ErrorPattern @relation(fields: [errorPatternId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([skillId, errorPatternId])
  @@index([errorPatternId])
  @@map("skill_error_patterns")
}

/// Registro falado × estrutura gramatical. Slug imutável, como Skill.
model RegisterNote {
  id String @id

  /// Como se fala: "gonna", "You coming?"
  spokenForm   String        @map("spoken_form")
  /// A estrutura completa: "going to", "Are you coming?"
  standardForm String        @map("standard_form")
  register     RegisterLevel
  /// pt-BR: o que muda e quando usar.
  explanation  String
  /// pt-BR: onde não cabe. "Não use em e-mail formal."
  whenToAvoid  String?       @map("when_to_avoid")
  cefrLevel    CefrLevel     @map("cefr_level")

  /// A skill (type REGISTER) que esta nota ensina, quando medimos.
  skillId      String?     @unique @map("skill_id")
  skill        Skill?      @relation(fields: [skillId], references: [id], onDelete: SetNull)
  audioAssetId String?     @map("audio_asset_id") @db.Uuid
  audioAsset   MediaAsset? @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)

  deprecatedAt DateTime?      @map("deprecated_at")
  replacedById String?        @map("replaced_by_id")
  replacedBy   RegisterNote?  @relation("RegisterNoteReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RegisterNote[] @relation("RegisterNoteReplacement")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cefrLevel])
  @@index([deprecatedAt])
  @@map("register_notes")
}

// --- Estrutura do curso ----------------------------------------------------

model Course {
  id String @id @default(uuid()) @db.Uuid

  slug        String  @unique
  language    String  @default("en")
  title       String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  levels Level[]

  @@map("courses")
}

model Level {
  id String @id @default(uuid()) @db.Uuid

  courseId  String    @map("course_id") @db.Uuid
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cefrLevel CefrLevel @map("cefr_level")

  title       String
  description String?
  /// Can-dos do nível, em pt-BR.
  objectives  String[]
  order       Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  units Unit[]

  @@unique([courseId, cefrLevel])
  @@unique([courseId, order])
  @@map("levels")
}

/// Um episódio da série: o elenco e um punhado de lições.
model Unit {
  id String @id @default(uuid()) @db.Uuid

  levelId String @map("level_id") @db.Uuid
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  slug     String        @unique
  order    Int
  title    String
  /// Sinopse do episódio, em pt-BR.
  synopsis String?
  status   ContentStatus @default(DRAFT)

  coverAssetId String?     @map("cover_asset_id") @db.Uuid
  coverAsset   MediaAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lessons   Lesson[]
  cast      UnitCharacter[]
  workbooks Workbook[]

  checkpoints UnitCheckpoint[]

  @@unique([levelId, order])
  @@index([status])
  @@map("units")
}

model Character {
  id String @id @default(uuid()) @db.Uuid

  slug    String  @unique
  name    String
  /// pt-BR.
  bio     String?
  /// Voz do TTS. O áudio em si é gerado no módulo 5.
  voiceId String? @map("voice_id")

  avatarAssetId String?     @map("avatar_asset_id") @db.Uuid
  avatarAsset   MediaAsset? @relation(fields: [avatarAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  units UnitCharacter[]

  @@map("characters")
}

model UnitCharacter {
  id String @id @default(uuid()) @db.Uuid

  unitId      String    @map("unit_id") @db.Uuid
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([unitId, characterId])
  @@index([characterId])
  @@map("unit_characters")
}

// --- Lição e versionamento -------------------------------------------------

/// Identidade estável da lição. O conteúdo mora nas versões.
model Lesson {
  id String @id @default(uuid()) @db.Uuid

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug   String @unique
  order  Int

  /// Ponteiro para o que o aluno vê. Nulo enquanto a lição nunca publicou.
  publishedVersionId String?        @unique @map("published_version_id") @db.Uuid
  publishedVersion   LessonVersion? @relation("LessonPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions LessonVersion[] @relation("LessonVersions")
  attempts LessonAttempt[]

  @@unique([unitId, order])
  @@map("lessons")
}

/// Uma versão editorial da lição. Editar a publicada cria a próxima em DRAFT.
/// É o id daqui que a tentativa do aluno guarda (módulo 6).
model LessonVersion {
  id String @id @default(uuid()) @db.Uuid

  lessonId String @map("lesson_id") @db.Uuid
  lesson   Lesson @relation("LessonVersions", fields: [lessonId], references: [id], onDelete: Cascade)
  version  Int

  status           ContentStatus @default(DRAFT)
  title            String
  /// Can-do em pt-BR: "se apresentar e responder a apresentações".
  objective        String
  cefrLevel        CefrLevel     @map("cefr_level")
  estimatedMinutes Int           @default(10) @map("estimated_minutes")

  approvedAt   DateTime? @map("approved_at")
  approvedById String?   @map("approved_by_id") @db.Uuid
  publishedAt  DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  steps        LessonStep[]
  targetSkills LessonTargetSkill[]
  usedItems    LessonVersionItem[]
  publishedFor Lesson?             @relation("LessonPublishedVersion")

  drafts    ContentDraft[]
  qaReports ContentQaReport[]
  comments  ContentComment[]

  attempts LessonAttempt[]

  @@unique([lessonId, version])
  @@index([status])
  @@map("lesson_versions")
}

model LessonStep {
  id String @id @default(uuid()) @db.Uuid

  lessonVersionId String         @map("lesson_version_id") @db.Uuid
  lessonVersion   LessonVersion  @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  order           Int
  type            LessonStepType
  /// Validado por zod conforme o `type` — ver packages/shared/lesson-content.
  content         Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lessonVersionId, order])
  @@map("lesson_steps")
}

model LessonTargetSkill {
  id String @id @default(uuid()) @db.Uuid

  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  skillId         String        @map("skill_id")
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  /// 0 = skill principal da lição.
  position        Int           @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lessonVersionId, skillId])
  @@index([skillId])
  @@map("lesson_target_skills")
}

/// Índice dos itens usados por uma versão de lição.
///
/// Os ids já estão dentro do JSON da etapa PRACTICE; esta tabela existe para
/// a pergunta inversa — "quem usa este item?" — que é o que barra arquivar
/// um item preso a uma lição publicada. Reescrita a cada publish.
model LessonVersionItem {
  id String @id @default(uuid()) @db.Uuid

  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  itemId          String        @map("item_id") @db.Uuid
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lessonVersionId, itemId])
  @@index([itemId])
  @@map("lesson_version_items")
}

// --- Banco de questões -----------------------------------------------------

/// Uma questão. Depois de PUBLISHED, `type`, `prompt`, `content` e
/// `acceptedAnswers` são imutáveis: mudar o enunciado de um item já
/// respondido invalidaria a estatística dele. A edição cria um item novo em
/// DRAFT e liga os dois por `replacedById`.
model Item {
  id String @id @default(uuid()) @db.Uuid

  /// Chave de autoria, para seed e import idempotentes. Nula em item gerado.
  slug String? @unique

  type    ItemType
  prompt  String
  content Json

  acceptedAnswers String[] @map("accepted_answers")
  /// pt-BR.
  explanation     String
  /// Resposta errada normalizada → id de ErrorPattern.
  errorPatternMap Json     @default("{}") @map("error_pattern_map")

  cefrLevel      CefrLevel @map("cefr_level")
  /// Escala logit. Inicial derivada do nível: A1 -2, A2 -1, B1 0, B2 1, C1 2.
  difficulty     Float
  discrimination Float     @default(1)
  exposureCount  Int       @default(0) @map("exposure_count")
  /// Nulo até ter exposição suficiente. Taxa bruta de acerto na primeira
  /// tentativa, recalculada em lote pelo learning (6); a calibração de
  /// `difficulty` a partir dela é do assessment (8).
  correctRate    Float?    @map("correct_rate")

  status ContentStatus @default(DRAFT)
  source ItemSource    @default(HUMAN)

  replacedById String? @map("replaced_by_id") @db.Uuid
  replacedBy   Item?   @relation("ItemReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     Item[]  @relation("ItemReplacement")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills  ItemSkill[]
  lessons LessonVersionItem[]
  answers Answer[]

  @@index([cefrLevel, status])
  @@index([status, difficulty])
  @@map("items")
}

model ItemSkill {
  id String @id @default(uuid()) @db.Uuid

  itemId   String @map("item_id") @db.Uuid
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  skillId  String @map("skill_id")
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  /// 0 = skill principal medida pelo item.
  position Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([itemId, skillId])
  @@index([skillId, position])
  @@map("item_skills")
}

// --- Mídia e apostilas -----------------------------------------------------

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  kind       MediaKind
  /// Sempre sob o prefixo content/.
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int?      @map("size_bytes")
  durationMs Int?      @map("duration_ms")
  meta       Json      @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registerNotes RegisterNote[]
  unitCovers    Unit[]
  avatars       Character[]
  workbooks     Workbook[]
  renditions    AudioRendition[]

  @@index([kind])
  @@map("media_assets")
}

/// Apostila em PDF da unidade. O módulo 5 é quem gera o arquivo.
model Workbook {
  id String @id @default(uuid()) @db.Uuid

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  slug        String        @unique
  title       String
  description String?
  order       Int
  status      ContentStatus @default(DRAFT)

  assetId String     @map("asset_id") @db.Uuid
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  /// Quando o PDF foi gerado e de qual conteúdo. Se o hash do conteúdo
  /// publicado da unidade mudar, a apostila está velha (módulo 5).
  generatedAt DateTime? @map("generated_at")
  sourceHash  String?   @map("source_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([unitId, order])
  @@index([status])
  @@map("workbooks")
}

// ---------------------------------------------------------------------------
// Módulo 5 — content-studio
// ---------------------------------------------------------------------------

enum ContentDraftKind {
  LESSON         @map("lesson")
  ITEMS          @map("items")
  REGISTER_NOTES @map("register_notes")

  @@map("content_draft_kind")
}

enum ContentDraftStatus {
  QUEUED     @map("queued")
  GENERATING @map("generating")
  QA_RUNNING @map("qa_running")
  READY      @map("ready")
  FAILED     @map("failed")
  DISCARDED  @map("discarded")

  @@map("content_draft_status")
}

/// Gravidade de um aviso de QA. BLOCKER impede a aprovação da versão;
/// WARNING e INFO só aparecem para o revisor.
enum QaSeverity {
  INFO    @map("info")
  WARNING @map("warning")
  BLOCKER @map("blocker")

  @@map("qa_severity")
}

enum CommentTarget {
  VERSION @map("version")
  STEP    @map("step")
  ITEM    @map("item")

  @@map("comment_target")
}

/// Um pedido de rascunho para a IA.
///
/// Não guarda o conteúdo: o job materializa direto em linha de verdade —
/// `LessonVersion` em DRAFT, `Item` com source AI_DRAFT — e esta tabela fica
/// com a proveniência (qual prompt, qual versão, quanto custou, quem pediu).
model ContentDraft {
  id String @id @default(uuid()) @db.Uuid

  kind          ContentDraftKind
  status        ContentDraftStatus @default(QUEUED)
  params        Json
  requestedById String             @map("requested_by_id") @db.Uuid
  requestedBy   User               @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  promptId      String? @map("prompt_id")
  promptVersion Int?    @map("prompt_version")
  model         String?
  costUsdMicros Int?    @map("cost_usd_micros")
  jobId         String? @map("job_id")

  lessonVersionId        String?        @map("lesson_version_id") @db.Uuid
  lessonVersion          LessonVersion? @relation(fields: [lessonVersionId], references: [id], onDelete: SetNull)
  createdItemIds         String[]       @map("created_item_ids") @db.Uuid
  createdRegisterNoteIds String[]       @map("created_register_note_ids")

  errorCode   String?   @map("error_code")
  generatedAt DateTime? @map("generated_at")
  discardedAt DateTime? @map("discarded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  qaReports ContentQaReport[]

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([lessonVersionId])
  @@map("content_drafts")
}

/// Resultado do job de QA: checagem de nível, de consistência e a revisão
/// linguística por IA. **Nunca altera o conteúdo** — só descreve o que viu.
model ContentQaReport {
  id String @id @default(uuid()) @db.Uuid

  lessonVersionId String?        @map("lesson_version_id") @db.Uuid
  lessonVersion   LessonVersion? @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  contentDraftId  String?        @map("content_draft_id") @db.Uuid
  contentDraft    ContentDraft?  @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)

  /// [{ code, severity, message, path }]
  warnings   Json @default("[]")
  /// { totalWords, outOfLevel, ratio, words[] }
  levelStats Json @default("{}")

  blockerCount Int @default(0) @map("blocker_count")
  warningCount Int @default(0) @map("warning_count")
  infoCount    Int @default(0) @map("info_count")

  ranAt     DateTime @default(now()) @map("ran_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonVersionId, ranAt])
  @@index([contentDraftId])
  @@map("content_qa_reports")
}

/// Comentário de revisão, preso a uma etapa ou a um item da versão.
model ContentComment {
  id String @id @default(uuid()) @db.Uuid

  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)

  target    CommentTarget @default(VERSION)
  /// Ordem da etapa ou id do item, conforme o `target`.
  targetRef String?       @map("target_ref")
  body      String

  authorId     String    @map("author_id") @db.Uuid
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lessonVersionId, createdAt])
  @@index([authorId])
  @@map("content_comments")
}

/// Áudio já sintetizado, indexado por hash(texto normalizado + voz).
///
/// TTS é produção única: a mesma fala com a mesma voz nunca é sintetizada
/// duas vezes, nem quando a lição ganha uma versão nova.
model AudioRendition {
  id String @id @default(uuid()) @db.Uuid

  textHash String     @map("text_hash")
  voiceId  String     @map("voice_id")
  assetId  String     @map("asset_id") @db.Uuid
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  provider  String
  charCount Int    @map("char_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([textHash, voiceId])
  @@index([assetId])
  @@map("audio_renditions")
}

// ===========================================================================
// Módulo 6 — learning
//
// Tudo o que o aluno faz. É a fonte de dados do modelo do aluno (7), do
// SRS (9) e da calibração dos itens (8): nada aqui é apagado ou reescrito
// depois de gravado, só acrescentado.
// ===========================================================================

enum LessonAttemptStatus {
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  /// Largada: hoje, só quando a lição ganha versão nova no meio do caminho.
  ABANDONED   @map("abandoned")

  @@map("lesson_attempt_status")
}

/// De onde o aluno chegou na lição. Recomendação, nunca trava.
enum LessonAttemptSource {
  PLAN        @map("plan")
  FREE_BROWSE @map("free_browse")
  REVIEW      @map("review")

  @@map("lesson_attempt_source")
}

enum AnswerContext {
  LESSON             @map("lesson")
  REVIEW             @map("review")
  PLACEMENT          @map("placement")
  CHECKPOINT         @map("checkpoint")
  GENERATED_MATERIAL @map("generated_material")

  @@map("answer_context")
}

/// Uma passada do aluno por uma lição.
///
/// Guarda a **versão** que ele fez, não só a lição: se a lição for
/// republicada, a tentativa continua dizendo exatamente o que o aluno viu.
///
/// No máximo uma IN_PROGRESS por aluno e lição — índice único parcial,
/// criado em SQL na migration (o Prisma não expressa `WHERE`).
model LessonAttempt {
  id String @id @default(uuid()) @db.Uuid

  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String        @map("lesson_id") @db.Uuid
  lesson          Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  /// O número da versão, para leitura sem join. O id acima é a referência.
  versionNumber   Int           @map("version_number")

  status           LessonAttemptStatus @default(IN_PROGRESS)
  source           LessonAttemptSource @default(FREE_BROWSE)
  /// Próxima etapa ainda não concluída. Igual ao total de etapas quando todas foram.
  currentStepIndex Int                 @default(0) @map("current_step_index")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  abandonedAt DateTime? @map("abandoned_at")
  xpEarned    Int       @default(0) @map("xp_earned")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  steps   StepProgress[]
  answers Answer[]

  @@index([userId, startedAt])
  @@index([userId, lessonId, status])
  @@map("lesson_attempts")
}

/// Etapa concluída dentro de uma tentativa. Única por (tentativa, etapa):
/// concluir de novo não duplica.
model StepProgress {
  id String @id @default(uuid()) @db.Uuid

  attemptId   String         @map("attempt_id") @db.Uuid
  attempt     LessonAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stepIndex   Int            @map("step_index")
  type        LessonStepType
  completedAt DateTime       @default(now()) @map("completed_at")
  timeSpentMs Int            @default(0) @map("time_spent_ms")
  /// Texto da produção livre. Guardado sem nota: a correção é dos módulos 7 e 12.
  /// Conteúdo do aluno — nunca vai para log.
  response    Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([attemptId, stepIndex])
  @@map("step_progress")
}

/// Resposta a uma questão objetiva, já corrigida.
model Answer {
  id String @id @default(uuid()) @db.Uuid

  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String         @map("item_id") @db.Uuid
  item      Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attemptId String?        @map("attempt_id") @db.Uuid
  attempt   LessonAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stepIndex Int?           @map("step_index")
  context   AnswerContext

  /// O que o aluno mandou, no formato do tipo do item. Nunca vai para log.
  response              Json
  isCorrect             Boolean  @map("is_correct")
  /// 0–1. Fracionário só em ORDER_WORDS e MATCH.
  score                 Float
  responseTimeMs        Int      @map("response_time_ms")
  hintsUsed             Int      @default(0) @map("hints_used")
  detectedErrorPatterns String[] @map("detected_error_patterns")
  /// Primeira resposta do aluno a este item nesta tentativa. Estatística do
  /// item e XP só contam a primeira: quem refaz até acertar não infla nada.
  isFirstTry            Boolean  @map("is_first_try")
  /// Id gerado pelo cliente. Reenvio pela rede devolve a mesma resposta.
  clientAnswerId        String?  @map("client_answer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, clientAnswerId])
  @@index([itemId, isFirstTry])
  @@index([attemptId, itemId])
  @@index([userId, createdAt])
  @@map("answers")
}

/// XP e sequência do aluno. Uma linha por aluno.
model LearningStats {
  id String @id @default(uuid()) @db.Uuid

  userId        String    @unique @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp       Int       @default(0) @map("total_xp")
  currentStreak Int       @default(0) @map("current_streak")
  longestStreak Int       @default(0) @map("longest_streak")
  /// Último dia com estudo, **no fuso do aluno**.
  lastStudyDate DateTime? @map("last_study_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("learning_stats")
}

// ===========================================================================
// Módulo 7 — learner-model
//
// O que o sistema sabe do aluno: habilidade por skill, erros recorrentes e
// a evolução do nível. Tudo derivado das respostas do learning (6) — dá
// para reconstruir do zero reprocessando as `answers`.
// ===========================================================================

/// Habilidade do aluno numa skill, em logit (mesma escala da dificuldade do item).
model LearnerSkillState {
  id String @id @default(uuid()) @db.Uuid

  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Slug de Skill. Sem FK de propósito: skill descontinuada não apaga histórico.
  skillId String @map("skill_id")

  theta           Float
  /// Soma dos pesos das respostas que atualizaram o theta (principal 1, secundária 0.5).
  evidenceCount   Float     @default(0) @map("evidence_count")
  correctStreak   Int       @default(0) @map("correct_streak")
  lastPracticedAt DateTime? @map("last_practiced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, skillId])
  @@map("learner_skill_states")
}

/// Um erro típico no histórico do aluno, com janela móvel.
model LearnerErrorPattern {
  id String @id @default(uuid()) @db.Uuid

  userId         String @map("user_id") @db.Uuid
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  errorPatternId String @map("error_pattern_id")

  /// As últimas respostas que **poderiam** revelar este erro, da mais antiga
  /// para a mais nova: true = o erro apareceu. Até 30.
  recentOutcomes   Boolean[] @map("recent_outcomes")
  totalOccurrences Int       @default(0) @map("total_occurrences")
  lastOccurredAt   DateTime? @map("last_occurred_at")
  /// As últimas 3 frases erradas do aluno, com a correção. Conteúdo do aluno:
  /// nunca vai para log, e vai para a IA só como dado não confiável.
  examples         Json      @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, errorPatternId])
  @@map("learner_error_patterns")
}

/// Foto semanal do nível, para mostrar a evolução. Gravada quando o modelo
/// muda — aluno parado não muda de nível.
model LearnerLevelSnapshot {
  id String @id @default(uuid()) @db.Uuid

  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Segunda-feira da semana, em UTC.
  weekStart    DateTime   @map("week_start") @db.Date
  overallLevel CefrLevel? @map("overall_level")
  /// Por competência: { theta, level, confidence, evidence }.
  levels       Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, weekStart])
  @@map("learner_level_snapshots")
}

/// Até onde o modelo do aluno já processou as respostas. É o que mantém a
/// ordem: o processamento sempre parte daqui, em ordem de criação.
model LearnerModelCursor {
  id String @id @default(uuid()) @db.Uuid

  userId       String    @unique @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastAnswerAt DateTime? @map("last_answer_at")
  lastAnswerId String?   @map("last_answer_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("learner_model_cursors")
}

/// Ponto de partida vindo do nivelamento (8). Skill nova começa no theta da
/// competência daqui, e o nivelamento entra na agregação como pseudo-evidência.
model LearnerPlacementPrior {
  id String @id @default(uuid()) @db.Uuid

  userId           String   @unique @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placementId      String   @map("placement_id") @db.Uuid
  overallTheta     Float    @map("overall_theta")
  /// Competency → theta.
  competencyThetas Json     @map("competency_thetas")
  placedAt         DateTime @map("placed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("learner_placement_priors")
}

// ===========================================================================
// Módulo 8 — assessment
//
// Nivelamento, checkpoints de unidade e calibração dos itens. As respostas
// em si continuam na tabela `answers` do learning (6); aqui fica o que liga
// cada uma a um teste e o resultado do teste.
// ===========================================================================

enum AssessmentStatus {
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  ABANDONED   @map("abandoned")

  @@map("assessment_status")
}

enum AssessmentKind {
  PLACEMENT  @map("placement")
  CHECKPOINT @map("checkpoint")

  @@map("assessment_kind")
}

/// A parte de escrita do nivelamento, corrigida pelo tutor (12) quando existir.
enum WritingStatus {
  NOT_OFFERED @map("not_offered")
  PENDING     @map("pending")
  SCORED      @map("scored")

  @@map("writing_status")
}

enum CheckpointResult {
  PASSED                    @map("passed")
  PASSED_WITH_REINFORCEMENT @map("passed_with_reinforcement")
  NEEDS_REINFORCEMENT       @map("needs_reinforcement")

  @@map("checkpoint_result")
}

/// Teste de nivelamento adaptativo. Um aberto por aluno (índice parcial na
/// migration); pode ser refeito 60 dias depois do último concluído.
model PlacementTest {
  id String @id @default(uuid()) @db.Uuid

  userId String           @map("user_id") @db.Uuid
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status AssessmentStatus @default(IN_PROGRESS)

  startLevel    CefrLevel @map("start_level")
  currentItemId String?   @map("current_item_id") @db.Uuid
  servedItemIds String[]  @map("served_item_ids")

  theta              Float?
  standardError      Float?        @map("standard_error")
  overallLevel       CefrLevel?    @map("overall_level")
  /// Competency → { theta, standardError, level, items }.
  levelsByCompetency Json?         @map("levels_by_competency")
  /// Skills de nível abaixo que o planejador (10) pode pular.
  masteredSkillIds   String[]      @map("mastered_skill_ids")
  /// O banco acabou antes do critério de parada. O nível vale menos.
  bankExhausted      Boolean       @default(false) @map("bank_exhausted")
  writingStatus      WritingStatus @default(NOT_OFFERED) @map("writing_status")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, completedAt])
  @@map("placement_tests")
}

/// Mini-prova adaptativa de uma unidade. Nunca trava nada: é diagnóstico.
model UnitCheckpoint {
  id String @id @default(uuid()) @db.Uuid

  userId String           @map("user_id") @db.Uuid
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId String           @map("unit_id") @db.Uuid
  unit   Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status AssessmentStatus @default(IN_PROGRESS)

  targetSkillIds String[] @map("target_skill_ids")
  /// Pontos fracos do aluno que entraram na prova, além das skills da unidade.
  weakSkillIds   String[] @map("weak_skill_ids")
  currentItemId  String?  @map("current_item_id") @db.Uuid
  servedItemIds  String[] @map("served_item_ids")

  result            CheckpointResult?
  reinforceSkillIds String[]          @map("reinforce_skill_ids")
  /// Skill → { priorTheta, theta?, p?, answered?, correct? }. O ponto de
  /// partida é congelado no início: as respostas do próprio checkpoint
  /// também atualizam o learner-model, e usá-lo de novo contaria duas vezes.
  skillResults      Json?             @map("skill_results")
  score             Float?

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, unitId])
  @@map("unit_checkpoints")
}

/// Liga uma resposta (`answers`, do learning) a um teste, com o que a
/// estimativa precisa congelado no momento: dificuldade e competência.
model AssessmentResponse {
  id String @id @default(uuid()) @db.Uuid

  kind     AssessmentKind
  /// Id do PlacementTest ou do UnitCheckpoint. Sem FK: são duas tabelas.
  testId   String         @map("test_id") @db.Uuid
  answerId String         @unique @map("answer_id") @db.Uuid
  itemId   String         @map("item_id") @db.Uuid

  skillIds   String[]
  competency Competency
  difficulty Float
  isCorrect  Boolean    @map("is_correct")
  position   Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([testId, position])
  @@index([testId])
  @@map("assessment_responses")
}

/// Uma rodada de calibração de um item: o que se estimou, o que se aplicou e
/// o que merece o olho do editor.
model ItemCalibration {
  id String @id @default(uuid()) @db.Uuid

  itemId              String    @map("item_id") @db.Uuid
  responses           Int
  pValue              Float     @map("p_value")
  estimatedDifficulty Float     @map("estimated_difficulty")
  previousDifficulty  Float     @map("previous_difficulty")
  appliedDifficulty   Float     @map("applied_difficulty")
  pointBiserial       Float?    @map("point_biserial")
  /// TOO_EASY, TOO_HARD, LOW_DISCRIMINATION.
  flags               String[]
  calibratedAt        DateTime  @map("calibrated_at")
  resolvedAt          DateTime? @map("resolved_at")
  resolvedById        String?   @map("resolved_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([itemId, calibratedAt])
  @@index([resolvedAt])
  @@map("item_calibrations")
}

enum ReviewCardKind {
  SKILL         @map("skill")
  VOCAB         @map("vocab")
  CHUNK         @map("chunk")
  REGISTER_NOTE @map("register_note")
  ERROR_PATTERN @map("error_pattern")

  @@map("review_card_kind")
}

enum ReviewCardSource {
  LESSON             @map("lesson")
  GENERATED_MATERIAL @map("generated_material")
  TUTOR_FEEDBACK     @map("tutor_feedback")
  PLACEMENT          @map("placement")

  @@map("review_card_source")
}

/// Mesmos quatro estados do `State` do ts-fsrs.
enum ReviewCardState {
  NEW        @map("new")
  LEARNING   @map("learning")
  REVIEW     @map("review")
  RELEARNING @map("relearning")

  @@map("review_card_state")
}

/// Card de revisão espaçada (FSRS). `refId` aponta para Skill, RegisterNote
/// ou ErrorPattern conforme o `kind` — sem FK, porque são três tabelas
/// diferentes (mesma ideia da referência dentro de JSON do módulo 4).
model ReviewCard {
  id String @id @default(uuid()) @db.Uuid

  userId String           @map("user_id") @db.Uuid
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   ReviewCardKind
  refId  String           @map("ref_id")
  source ReviewCardSource

  due            DateTime
  stability      Float
  difficulty     Float
  /// Campos que o ts-fsrs precisa para o próximo cálculo.
  scheduledDays  Int             @default(0) @map("scheduled_days")
  learningSteps  Int             @default(0) @map("learning_steps")
  reps           Int             @default(0)
  lapses         Int             @default(0)
  state          ReviewCardState @default(NEW)
  lastReviewedAt DateTime?       @map("last_reviewed_at")

  suspended Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, kind, refId])
  @@index([userId, due])
  @@map("review_cards")
}

/// Marca d'água por aluno para processar `lesson.completed` e
/// `answer.submitted` em ordem, sob a mesma trava (padrão do módulo 7).
model SrsUpdateCursor {
  id String @id @default(uuid()) @db.Uuid

  userId       String    @unique @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastAnswerAt DateTime? @map("last_answer_at")
  lastAnswerId String?   @map("last_answer_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("srs_update_cursors")
}

/// A trilha de lições e o forecast até o nível-alvo. Um ativo por aluno —
/// reconstrução idempotente, não um histórico de versões.
model StudyPlan {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetLevel CefrLevel @map("target_level")
  /// Espelha o `StudentProfile.targetDate` no momento do último rebuild.
  targetDate  DateTime? @map("target_date")

  /// Só o que falta: `{lessonId, unitId, cefrLevel, order, reason}[]`, na
  /// ordem em que o aluno deveria fazer.
  path Json

  /// Fraquezas priorizadas: do learner-model e de checkpoint com reforço.
  reinforceSkillIds String[] @map("reinforce_skill_ids")

  /// `{estimatedArrival, weeksNeeded, realistic, message}`.
  forecast Json?

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("study_plans")
}

/// A agenda de um dia local do aluno. Gerada sob demanda e cacheada aqui só
/// para os blocos poderem ser marcados como pulados entre uma leitura e
/// outra no mesmo dia.
model DailyAgenda {
  id String @id @default(uuid()) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `YYYY-MM-DD` no fuso do aluno — não é o `created_at` em UTC.
  localDate String @map("local_date")

  /// `{id, type, refId, estimatedMinutes, reason, skipped}[]`.
  blocks      Json
  generatedAt DateTime @default(now()) @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, localDate])
  @@map("daily_agendas")
}

// ===========================================================================
// Módulo 11 — billing
//
// Planos, assinatura no Asaas e créditos de IA. O tier do aluno nunca viaja
// no JWT: é lido daqui a cada checagem, para cancelar ou assinar valer na
// hora, sem novo login.
// ===========================================================================

enum PlanTier {
  FREE @map("free")
  BASE @map("base")
  PLUS @map("plus")

  @@map("plan_tier")
}

enum BillingPeriod {
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")

  @@map("billing_period")
}

/// PENDING = checkout aberto, primeiro pagamento ainda não confirmado.
enum SubscriptionStatus {
  PENDING  @map("pending")
  ACTIVE   @map("active")
  PAST_DUE @map("past_due")
  CANCELED @map("canceled")
  EXPIRED  @map("expired")

  @@map("subscription_status")
}

enum PaymentMethod {
  PIX         @map("pix")
  BOLETO      @map("boleto")
  CREDIT_CARD @map("credit_card")

  @@map("payment_method")
}

enum AiCreditEntryKind {
  GRANT   @map("grant")
  CONSUME @map("consume")
  REFUND  @map("refund")
  BONUS   @map("bonus")

  @@map("ai_credit_entry_kind")
}

enum Feature {
  LESSON_ACCESS    @map("lesson_access")
  TUTOR_CORRECTION @map("tutor_correction")
  TUTOR_ROLEPLAY   @map("tutor_roleplay")
  GENERATOR_TOPIC  @map("generator_topic")
  GENERATOR_INGEST @map("generator_ingest")
  PDF_DOWNLOAD     @map("pdf_download")

  @@map("feature")
}

/// Catálogo de planos, editável pelo admin. FREE não tem período nem preço:
/// existe só para guardar a cota de créditos dele.
model SubscriptionPlan {
  id String @id @default(uuid()) @db.Uuid

  tier             PlanTier
  billingPeriod    BillingPeriod? @map("billing_period")
  priceCents       Int            @map("price_cents")
  monthlyAiCredits Int            @map("monthly_ai_credits")
  /// Desativar tira o plano da vitrine sem apagar quem já assinou.
  active           Boolean        @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@unique([tier, billingPeriod])
  @@map("subscription_plans")
}

/// Histórico de assinaturas do aluno — cancelar e assinar de novo cria outra
/// linha. No máximo uma PENDING/ACTIVE/PAST_DUE por aluno (índice parcial
/// escrito à mão na migration).
model Subscription {
  id String @id @default(uuid()) @db.Uuid

  userId String           @map("user_id") @db.Uuid
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String           @map("plan_id") @db.Uuid
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  /// Copiados do plano na criação: mudar o catálogo não mexe em quem já assinou.
  tier          PlanTier
  billingPeriod BillingPeriod @map("billing_period")
  priceCents    Int           @map("price_cents")
  paymentMethod PaymentMethod @map("payment_method")

  status SubscriptionStatus @default(PENDING)

  asaasCustomerId     String? @map("asaas_customer_id")
  asaasSubscriptionId String? @unique @map("asaas_subscription_id")
  /// Link de pagamento do Asaas. Nasce nulo: o job de checkout preenche.
  checkoutUrl         String? @map("checkout_url")

  /// Até quando o que já foi pago dá acesso. Cada pagamento confirmado empurra.
  currentPeriodEnd DateTime? @map("current_period_end")
  canceledAt       DateTime? @map("canceled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("subscriptions")
}

/// Lançamento de crédito de IA. Append-only: o saldo é a soma de `amount`.
model AiCreditLedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind    AiCreditEntryKind
  /// Positivo em GRANT/REFUND/BONUS, negativo em CONSUME.
  amount  Int
  feature Feature?
  reason  String?

  /// Só em REFUND: o CONSUME que ele devolve. Único — estornar duas vezes
  /// o mesmo consumo não duplica.
  reversalOfId String?              @unique @map("reversal_of_id") @db.Uuid
  reversalOf   AiCreditLedgerEntry? @relation("CreditReversal", fields: [reversalOfId], references: [id])
  reversedBy   AiCreditLedgerEntry? @relation("CreditReversal")

  /// Só em GRANT: `PLUS:2026-09`. Deduplica o crédito do mês.
  cycleKey String? @map("cycle_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, kind, cycleKey])
  @@index([userId, createdAt])
  @@map("ai_credit_ledger_entries")
}

/// Webhook do Asaas já processado. A linha entra na mesma transação que o
/// efeito — entregar o mesmo evento de novo não faz nada.
model AsaasWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  externalEventId String   @unique @map("external_event_id")
  eventType       String   @map("event_type")
  payload         Json
  processedAt     DateTime @default(now()) @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("asaas_webhook_events")
}
