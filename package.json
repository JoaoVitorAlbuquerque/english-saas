{
  "name": "english-saas",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:migrate": "dotenv -e .env -- pnpm --filter @english-saas/api exec prisma migrate dev",
    "db:deploy": "dotenv -e .env -- pnpm --filter @english-saas/api exec prisma migrate deploy",
    "db:generate": "pnpm --filter @english-saas/api exec prisma generate",
    "db:studio": "dotenv -e .env -- pnpm --filter @english-saas/api exec prisma studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @english-saas/api run db:seed",
    "db:reset": "dotenv -e .env -- pnpm --filter @english-saas/api exec prisma migrate reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "dotenv-cli": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
