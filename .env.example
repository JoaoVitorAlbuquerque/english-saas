# ============================================================================
# english-saas — variáveis de ambiente
#
# Copie para `.env` na raiz do monorepo:
#   cp .env.example .env
#
# Os valores abaixo já apontam para os serviços do `docker-compose.yml`,
# então em desenvolvimento local basta copiar e rodar.
# ============================================================================

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Porta HTTP da API (apps/api)
PORT=3333
# URL pública da API — usada em links de webhook, e-mails e assets
API_URL=http://localhost:3333
# URL do front-end — usada no CORS e em links enviados ao aluno
WEB_URL=http://localhost:5173
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL 16 — serviço `postgres` do docker-compose)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://english:english@localhost:5432/english_saas?schema=public"
# Banco usado pelos testes e2e (serviço `postgres-test`, outra porta).
# É recriado a cada rodada — nunca aponte para o banco de desenvolvimento.
DATABASE_TEST_URL="postgresql://english:english@localhost:5433/english_saas_test?schema=public"

# ---------------------------------------------------------------------------
# Redis (filas BullMQ, jobs agendados e cache — serviço `redis`)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Prefixo das chaves das filas. Permite compartilhar um Redis entre ambientes.
QUEUE_PREFIX=english-saas
# Jobs processados em paralelo por worker, por fila
QUEUE_CONCURRENCY=5
# Tentativas por job antes de ele ir para a lista de falhas
QUEUE_ATTEMPTS=3
# Atraso inicial do backoff exponencial entre tentativas (ms)
QUEUE_BACKOFF_MS=2000

# Painel Bull Board em /admin/queues.
# Proteção provisória por basic auth — vira guard de admin no módulo 3 (auth).
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change_me_please

# ---------------------------------------------------------------------------
# Armazenamento S3 (MinIO local — serviço `minio`)
# Guarda áudios das cenas, imagens dos personagens, PDFs das apostilas
# e uploads do aluno.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=english-saas
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true no MinIO (bucket no path), false na AWS (bucket no subdomínio)
S3_FORCE_PATH_STYLE=true
# Base para montar URLs públicas dos objetos (CDN em produção)
S3_PUBLIC_URL=http://localhost:9000/english-saas
# Validade padrão de uma URL assinada, em segundos
S3_SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Catálogo de conteúdo (módulo 4)
# ---------------------------------------------------------------------------
# Validade da URL assinada de áudio, imagem e PDF de lição. Mais longa que a
# padrão do S3 porque o aluno abre a lição e fica nela.
CONTENT_URL_TTL_SECONDS=3600
# TTL do catálogo no Redis. 0 desliga o cache.
# A versão da lição entra na chave, então publicar já invalida sozinho.
CATALOG_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Content studio (módulo 5)
# ---------------------------------------------------------------------------
# Síntese de voz. Hoje só 'fake', que gera um WAV silencioso válido.
# O adapter do fornecedor de verdade entra como mais um valor aqui.
TTS_PROVIDER=fake
# Voz usada quando o personagem não tem voiceId próprio
TTS_DEFAULT_VOICE=en-us-neutral-01
# Fala mais pausada em nível baixo. 1 = velocidade natural
TTS_SPEAKING_RATE_A1=0.9
TTS_MAX_CHARS=2000
# Teto de palavras acima do nível num rascunho, em fração (0.05 = 5%)
CONTENT_QA_MAX_OUT_OF_LEVEL=0.05

# ---------------------------------------------------------------------------
# Learning (módulo 6)
# Janela do lote que recalcula exposureCount/correctRate de um item (ms)
# ---------------------------------------------------------------------------
ITEM_STATS_DELAY_MS=30000

# ---------------------------------------------------------------------------
# Autenticação (JWT)
# Em produção gere com: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=dev_only_change_me_before_deploy
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_only_change_me_before_deploy_refresh
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Cookie do refresh token
#
# AUTH_COOKIE_DOMAIN precisa ser o dominio pai (ex.: .exemplo.com.br) para o
# cookie valer entre app.exemplo.com.br e api.exemplo.com.br. Em localhost
# deixe VAZIO: o browser recusa cookie com dominio para host sem ponto.
# Em producao: AUTH_COOKIE_SECURE=true.
# ---------------------------------------------------------------------------
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Login com Google (OAuth 2.0 + PKCE)
# Console: https://console.cloud.google.com/apis/credentials
# Sem GOOGLE_CLIENT_ID a API usa o cliente fake e avisa no log.
# O redirect precisa bater exatamente com o cadastrado no Google.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ---------------------------------------------------------------------------
# E-mail transacional (Resend)
# auto    = Resend quando houver RESEND_API_KEY, senao imprime no console
# resend  = exige a chave (use em producao)
# console = nunca envia de verdade
# ---------------------------------------------------------------------------
MAIL_PROVIDER=auto
RESEND_API_KEY=
MAIL_FROM="english-saas <nao-responda@exemplo.com.br>"

# ---------------------------------------------------------------------------
# LGPD
# Subir a versao faz todos os alunos aparecerem como pendentes de aceite.
# ---------------------------------------------------------------------------
TERMS_VERSION=2026-01-01
PRIVACY_POLICY_VERSION=2026-01-01
# Validade da URL assinada do export de dados, em horas
DATA_EXPORT_TTL_HOURS=48

# ---------------------------------------------------------------------------
# IA (OpenAI)
# AI_MODEL_FAST: tarefas baratas e de alto volume (correção curta,
#   classificação de erro, tradução de apoio, geração de distratores).
# AI_MODEL_SMART: tarefas caras e sensíveis (geração de material a partir de
#   tema/fonte, roleplay do tutor, feedback de produção livre).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# auto  = fake em NODE_ENV=test ou sem OPENAI_API_KEY, OpenAI no resto
# openai = exige a chave (use em producao)
# fake   = nunca chama a OpenAI
AI_PROVIDER=auto
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_SMART=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
# Timeout por chamada de IA (ms). Acima disso o job falha e entra em retry.
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Cota mensal de créditos do Plus usada pelo seed de planos (depois vale a do banco)
AI_MONTHLY_CREDITS_PLUS=500
# Custo real de IA de um aluno no mês que dispara alerta interno (micros de US$)
AI_USER_MONTHLY_COST_ALERT_USD_MICROS=2000000

# Preco por modelo, em micros de dolar por 1 milhao de tokens.
# Fora do codigo de proposito: preco muda sem merecer deploy.
# Vazio usa a tabela padrao embutida (gpt-4o, gpt-4o-mini, gpt-4.1*).
AI_PRICING_JSON=
# TTL padrao do cache de resultados de IA (segundos)
AI_CACHE_TTL_SECONDS=86400
# Teto de caracteres de conteudo do aluno quando o prompt nao define o seu
AI_MAX_INPUT_CHARS=20000

# ---------------------------------------------------------------------------
# Pagamentos (Asaas — Pix, boleto, cartão e assinaturas)
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
# ---------------------------------------------------------------------------
# auto = fake em teste ou sem ASAAS_API_KEY; em produção use asaas
PAYMENT_PROVIDER=auto
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Token combinado no painel do Asaas e conferido em todo webhook recebido
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Fontes externas de conteúdo (módulo 13 generator)
# A Wikimedia exige um User-Agent identificável com contato.
# https://meta.wikimedia.org/wiki/User-Agent_policy
# ---------------------------------------------------------------------------
WIKIPEDIA_USER_AGENT="english-saas/0.1 (contato@exemplo.com.br)"
WIKIPEDIA_API_URL=https://pt.wikipedia.org/w/api.php
# Timeout ao buscar uma URL enviada pelo aluno (reportagem, letra de música)
CONTENT_FETCH_TIMEOUT_MS=15000
# Teto de caracteres extraídos de um conteúdo colado/importado pelo aluno
CONTENT_MAX_CHARS=40000

# ---------------------------------------------------------------------------
# Rate limit (por IP, janela deslizante)
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Front-end (apps/web) — só variáveis VITE_* chegam ao browser.
# Nunca coloque segredo aqui.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3333
